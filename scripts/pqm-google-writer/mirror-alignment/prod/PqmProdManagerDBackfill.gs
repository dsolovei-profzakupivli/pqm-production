var PQM_MANAGER_D_READ_BATCH = 50;
var PQM_MANAGER_D_WRITE_BATCH = 20;
var PQM_MANAGER_D_RECOVERY_CONFIRMATION = 'RECOVER_MANAGER_D_EXACT_OR_BLANK';

function pqmProdManagerDManifest_() {
  if (PQM_MANAGER_D_BACKFILL.length !== 135) throw new Error('Manager D: manifest must contain exactly 135.');
  if (Object.keys(PQM_MANAGER_D_RECOVERY_EXACT).length !== 21)
    throw new Error('Manager D: recovery set must contain exactly 21.');
  var seen = new Set();
  var manifest = PQM_MANAGER_D_BACKFILL.map(function(r) {
    var item = {code: r[0], row: r[1], submission_id: r[2],
      submission_date: r[3], manager: r[4], provenance_submission_id: r[5]};
    if (!item.code || !/^\d+$/.test(item.code) || seen.has(item.code) ||
        PQM_MANAGER_D_EXCLUDED.indexOf(item.code) >= 0 ||
        !Number.isInteger(item.row) || item.row < 2 ||
        !item.submission_id || !/^\d{4}-\d{2}-\d{2}$/.test(item.submission_date) ||
        !item.manager || !item.manager.trim() || item.manager.indexOf('\uFFFD') >= 0 ||
        !item.provenance_submission_id) {
      throw new Error('Manager D: invalid frozen manifest.');
    }
    seen.add(item.code);
    return item;
  });
  Object.keys(PQM_MANAGER_D_RECOVERY_EXACT).forEach(function(code) {
    if (!seen.has(code) || !PQM_MANAGER_D_RECOVERY_EXACT[code].includes('\uFFFD'))
      throw new Error('Manager D: invalid exact recovery value or identity.');
  });
  return manifest;
}

function pqmProdManagerDReadRows_(id, manifest) {
  var output = {};
  for (var start = 0; start < manifest.length; start += PQM_MANAGER_D_READ_BATCH) {
    var batch = manifest.slice(start, start + PQM_MANAGER_D_READ_BATCH);
    var ranges = batch.map(function(item) { return "'ЮО'!B" + item.row + ':D' + item.row; });
    var response = Sheets.Spreadsheets.Values.batchGet(id, {
      ranges: ranges, valueRenderOption: 'FORMATTED_VALUE'
    });
    if (!response || !Array.isArray(response.valueRanges) ||
        response.valueRanges.length !== ranges.length)
      throw new Error('Manager D: incomplete row read; zero writes.');
    batch.forEach(function(item, i) {
      var values = (response.valueRanges[i].values || [])[0] || [];
      output[item.code] = {code: String(values[0] || ''), d: String(values[2] || '')};
    });
  }
  return output;
}

function pqmProdManagerDCheckIdentity_(id, manifest) {
  var expected = new Map(manifest.map(function(item) { return [item.code, 0]; }));
  var metadata = Sheets.Spreadsheets.get(id, {
    includeGridData: false, fields: 'sheets(properties(title,gridProperties(rowCount)))'
  });
  var ranges = [];
  ['ФОП', 'ЮО'].forEach(function(tab) {
    var sheet = (metadata.sheets || []).find(function(x) { return x.properties.title === tab; });
    if (!sheet) throw new Error('Manager D: missing tab ' + tab);
    var last = sheet.properties.gridProperties.rowCount;
    for (var first = 2; first <= last; first += 1000) {
      ranges.push("'" + tab + "'!B" + first + ':B' + Math.min(last, first + 999));
    }
  });
  var response = Sheets.Spreadsheets.Values.batchGet(id, {
    ranges: ranges, valueRenderOption: 'FORMATTED_VALUE'
  });
  if (!response || !response.valueRanges || response.valueRanges.length !== ranges.length)
    throw new Error('Manager D: incomplete identity scan; zero writes.');
  response.valueRanges.forEach(function(range) {
    (range.values || []).forEach(function(row) {
      var code = String((row || [])[0] || '').trim();
      if (expected.has(code)) expected.set(code, expected.get(code) + 1);
    });
  });
  expected.forEach(function(count, code) {
    if (count !== 1) throw new Error('Manager D: identity count ' + code + ' = ' + count + '; zero writes.');
  });
}

function pqmProdManagerDSourceGuard_(manifest) {
  var body = pqmProdFetchRegistry_();
  var byCode = new Map();
  (body.items || []).forEach(function(x) {
    var code = String(x.supplier_code || '').trim();
    if (byCode.has(code)) throw new Error('Manager D: duplicate PQM identity; zero writes.');
    byCode.set(code, x);
  });
  manifest.forEach(function(item) {
    var source = byCode.get(item.code);
    if (!source || source.entity_type !== 'legal_entity' ||
        source.google_sync_eligible !== true ||
        source.last_application_date !== item.submission_date)
      throw new Error('Manager D: PQM latest application changed for ' + item.code + '; zero writes.');
  });
}

function pqmProdManagerDState_(id) {
  var manifest = pqmProdManagerDManifest_();
  pqmProdManagerDSourceGuard_(manifest);
  pqmProdManagerDCheckIdentity_(id, manifest);
  var rows = pqmProdManagerDReadRows_(id, manifest);
  var ready = [], complete = [], conflicts = [], corrupted = [];
  manifest.forEach(function(item) {
    var actual = rows[item.code];
    if (actual.code !== item.code)
      conflicts.push({supplier_code: item.code, reason: 'row_identity_changed'});
    else if (!actual.d.trim()) ready.push(Object.assign({mode: 'blank'}, item));
    else if (actual.d === item.manager) complete.push(item.code);
    else if (Object.prototype.hasOwnProperty.call(PQM_MANAGER_D_RECOVERY_EXACT, item.code) &&
             actual.d === PQM_MANAGER_D_RECOVERY_EXACT[item.code]) {
      var recovery = Object.assign({mode: 'exact_corrupted'}, item);
      ready.push(recovery); corrupted.push(item.code);
    }
    else conflicts.push({supplier_code: item.code, reason: 'nonblank_d'});
  });
  var digest = pqmProdControlledDigest_({
    version: 1, spreadsheet_id: id,
    manifest: manifest.map(function(x) { return [x.code, x.row, x.submission_id, x.submission_date, x.manager, x.provenance_submission_id]; }),
    recovery_exact: PQM_MANAGER_D_RECOVERY_EXACT,
    state: manifest.map(function(x) { return [x.code, rows[x.code].code, rows[x.code].d]; })
  });
  return {manifest: manifest, ready: ready, complete: complete, conflicts: conflicts,
    corrupted: corrupted, digest: digest};
}

function pqmProdManagerDBackfillPreview() {
  var id = pqmProdControlledSpreadsheetId_();
  var state = pqmProdManagerDState_(id);
  var result = {dry_run: true, google_writes: 0, allowlist: 135,
    ready: state.ready.length, already_complete: state.complete.length,
    exact_corrupted_to_repair: state.corrupted.length,
    selected_codes: state.ready.map(function(item) { return item.code; }),
    conflicts: state.conflicts, excluded: PQM_MANAGER_D_EXCLUDED,
    planned_columns: ['D'], digest: state.digest};
  console.log(JSON.stringify(result));
  return result;
}

// Launch from an open spreadsheet UI entrypoint, never from the editor.
function pqmProdManagerDBackfillApply() {
  var lock = LockService.getDocumentLock();
  if (!lock || !lock.tryLock(30000))
    throw new Error('Manager D: another document operation is running; zero writes.');
  try { return pqmProdManagerDBackfillApplyLocked_(); }
  finally { lock.releaseLock(); }
}

function pqmProdManagerDBackfillApplyLocked_() {
  pqmMirrorContext_();
  var ui = SpreadsheetApp.getUi(), id = pqmProdControlledSpreadsheetId_();
  var initial = pqmProdManagerDState_(id);
  if (initial.conflicts.length) throw new Error('Manager D: conflicts; no writes.');
  var answer = ui.prompt('PQM · blank-only D backfill',
    'Paste the exact digest from a fresh Preview:', ui.ButtonSet.OK_CANCEL);
  if (answer.getSelectedButton() !== ui.Button.OK) return {cancelled: true, google_writes: 0};
  if (answer.getResponseText().trim() !== initial.digest)
    throw new Error('Manager D: stale or incorrect digest; zero writes.');
  var confirmation = ui.prompt('PQM · confirm D-only recovery',
    'Type ' + PQM_MANAGER_D_RECOVERY_CONFIRMATION + ' to repair exactly ' +
    initial.corrupted.length + ' known corrupted D and fill at most ' +
    (initial.ready.length - initial.corrupted.length) + ' blank D cells.',
    ui.ButtonSet.OK_CANCEL);
  if (confirmation.getSelectedButton() !== ui.Button.OK ||
      confirmation.getResponseText().trim() !== PQM_MANAGER_D_RECOVERY_CONFIRMATION)
    return {cancelled: true, google_writes: 0};
  var fresh = pqmProdManagerDState_(id);
  if (fresh.digest !== initial.digest || fresh.conflicts.length)
    throw new Error('Manager D: state changed before write; zero writes.');
  var verified = [], attempted = [];
  try {
    for (var start = 0; start < fresh.ready.length; start += PQM_MANAGER_D_WRITE_BATCH) {
      var batch = fresh.ready.slice(start, start + PQM_MANAGER_D_WRITE_BATCH);
      var before = pqmProdManagerDReadRows_(id, batch);
      batch.forEach(function(item) {
        var current = before[item.code];
        var allowed = item.mode === 'blank' ? !current.d.trim() :
          item.mode === 'exact_corrupted' &&
          current.d === PQM_MANAGER_D_RECOVERY_EXACT[item.code];
        if (current.code !== item.code || !allowed)
          throw new Error('stale B/D immediately before batch write: ' + item.code);
      });
      attempted = batch.map(function(item) { return item.code; });
      pqmMirrorValuesBatchUpdate_({
        valueInputOption: 'RAW',
        data: batch.map(function(item) {
          return {range: "'ЮО'!D" + item.row, values: [[item.manager]]};
        })
      }, id);
      var after = pqmProdManagerDReadRows_(id, batch);
      batch.forEach(function(item) {
        if (after[item.code].code !== item.code || after[item.code].d !== item.manager)
          throw new Error('post-write batch verification failed: ' + item.code);
      });
      verified = verified.concat(attempted);
      attempted = [];
    }
  } catch (error) {
    var detail = {status: 'PARTIAL_OR_UNCERTAIN', verified: verified, in_flight: attempted,
      error: String(error)};
    console.error(JSON.stringify(detail));
    throw new Error('Manager D: PARTIAL_OR_UNCERTAIN; run read-only reconciliation, never blind retry. ' +
      JSON.stringify(detail));
  }
  var result = {status: 'SUCCESS', google_writes: verified.length,
    updated_codes: verified, already_complete: fresh.complete.length,
    excluded: PQM_MANAGER_D_EXCLUDED};
  console.log(JSON.stringify(result));
  return result;
}
