# Only for a NEW pqm-sandbox service; not for pqm-production-1.
# Docker command: python sandbox_runtime.py
# Pre-deploy: python validation/docker_release_gate.py
# Disk: /var/data, 10 GB. Health: /api/health. Auto-Deploy: Off.
PQM_SANDBOX=1
PQM_ENV=test_web
PQM_DATA_DIR=/var/data
PQM_DB_PATH=/var/data/pqm_sandbox.sqlite3
PQM_SAFE_MODE=1
PQM_AUTH_ENABLED=1
PQM_LOCAL_ROLE_IMPERSONATION=0
PQM_RELEASE_SCHEMA_ONLY=1
PQM_ENABLE_BROWSER=0
PQM_ENABLE_SCHEDULER=0
PQM_ENABLE_PROZORRO_SCHEDULER=0
PQM_ENABLE_VIOLATION_SCHEDULER=0
PQM_ENABLE_NAZK_SCHEDULER=0
PQM_ENABLE_NAZK_WORKFLOW=0
PQM_ENABLE_GOOGLE=0
PQM_ENABLE_BIDS_UPDATE=0
PQM_ENABLE_POWERBI=0
PQM_BIDS_MODE=disabled
PQM_CURRENT_USER=SANDBOX
